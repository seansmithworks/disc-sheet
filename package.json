{
  "name": "@seansmithworks/disc-sheet",
  "version": "0.1.0",
  "type": "module",
  "description": "Draggable disc that morphs into a modal sheet. Generic React primitive, compound-component API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seansmithworks/disc-sheet.git"
  },
  "homepage": "https://github.com/seansmithworks/disc-sheet#readme",
  "bugs": {
    "url": "https://github.com/seansmithworks/disc-sheet/issues"
  },
  "keywords": [
    "react",
    "sheet",
    "modal",
    "disc",
    "fab",
    "motion",
    "framer-motion",
    "dialog",
    "morph"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "disc-sheet": "./bin/disc-sheet.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "dev": "vite example",
    "build:example": "vite build example",
    "build:lib": "vite build -c vite.lib.config.ts",
    "test": "vitest run",
    "test:geometry": "playwright test -c example/playwright.config.ts",
    "audit:vars": "node scripts/audit-css-vars.mjs",
    "assert:client-banner": "node -e \"if (require('fs').readFileSync('dist/index.js','utf8').split('\\n')[0] !== '\\\"use client\\\";') { console.error('dist/index.js is missing the \\\"use client\\\" banner on line 1'); process.exit(1); }\"",
    "prepublishOnly": "npm test && npm run audit:vars && npm run build:lib && npm run assert:client-banner && npm run test:geometry"
  }
}
